{
  "name": "index-rebalancer-sync",
  "main": "worker.js",
  "compatibility_date": "2025-12-01",
  "workers_dev": true,
  "vars": {"WORKSPACE_ID":"portfolio", "GITHUB_BACKUP_REPOSITORY":"XiaoyeCodes/Index-Rebalancer-Automation", "GITHUB_BACKUP_BRANCH":"codex/investment-backups"},
  "durable_objects": {"bindings":[{"name":"BOOKS","class_name":"SharedBook"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["SharedBook"]}]
}
